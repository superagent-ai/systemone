# Comma-separated early-user keys. Generate each with: openssl rand -hex 32
NAGATO_API_KEYS=replace-me

# SGLang server. Leave MODEL_PATH empty when the server is managed separately.
NAGATO_BACKEND_URL=http://127.0.0.1:30000
NAGATO_MODEL_PATH=
NAGATO_SERVED_MODEL=nagato-27b-2026-09-20
NAGATO_MODEL_ALIASES=nagato,nagato-latest,openjev,jev-latest

NAGATO_MAX_BODY_BYTES=1048576
NAGATO_MAX_QUESTIONS=64
NAGATO_MAX_ANSWERS=16
NAGATO_MAX_INPUT_TOKENS=32768
NAGATO_MAX_TOTAL_INPUT_TOKENS=262144
NAGATO_MAX_CONCURRENT_REQUESTS=32
NAGATO_MAX_CONCURRENT_BRANCHES=128
NAGATO_REQUEST_TIMEOUT_SECONDS=120
NAGATO_STARTUP_TIMEOUT_SECONDS=900
NAGATO_TEMPERATURE=1.0905077326652577

