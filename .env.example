# Comma-separated internal/testing keys. Generate each with: openssl rand -hex 32
SYSTEMONE_API_KEYS=replace-me
# Optional additional comma-separated keys kept separate from the primary secret.
SYSTEMONE_API_KEYS_SECONDARY=

# Development can be unauthenticated only with no static keys and no DB URL.
# Modal forces production mode in code and refuses to start without the lookup URL.
SYSTEMONE_ENVIRONMENT=development
# Server-only, dedicated read-only Postgres role; NEVER NEXT_PUBLIC_ or a service-role key.
SYSTEMONE_CUSTOMER_KEY_DATABASE_URL=
# Fallback only when a scoped DB role is impractical. Broad server-side credential risk!
# Both must be set together. Never NEXT_PUBLIC_ and never commit the service key.
SYSTEMONE_CUSTOMER_KEY_SUPABASE_URL=
SYSTEMONE_CUSTOMER_KEY_SUPABASE_SERVICE_KEY=
SYSTEMONE_CUSTOMER_AUTH_POOL_SIZE=8
SYSTEMONE_CUSTOMER_AUTH_TIMEOUT_SECONDS=1
SYSTEMONE_CUSTOMER_AUTH_CONNECT_SECONDS=1
SYSTEMONE_CUSTOMER_AUTH_QUERY_SECONDS=0.5

# SGLang server. Leave MODEL_PATH empty when the server is managed separately.
SYSTEMONE_BACKEND_URL=http://127.0.0.1:30000
SYSTEMONE_MODEL_PATH=
SYSTEMONE_SERVED_MODEL=security-one
SYSTEMONE_MODEL_ALIASES=security-one-latest,systemone,systemone-latest,openjev,jev-latest
SYSTEMONE_RELEASE_DATE=2026-09-25

SYSTEMONE_MAX_BODY_BYTES=1048576
SYSTEMONE_MAX_QUESTIONS=64
SYSTEMONE_MAX_ANSWERS=16
SYSTEMONE_MAX_INPUT_TOKENS=65536
SYSTEMONE_MAX_TOTAL_INPUT_TOKENS=131072
SYSTEMONE_MAX_CONCURRENT_REQUESTS=32
SYSTEMONE_MAX_CONCURRENT_BRANCHES=128
SYSTEMONE_REQUEST_TIMEOUT_SECONDS=120
SYSTEMONE_STARTUP_TIMEOUT_SECONDS=900
SYSTEMONE_TEMPERATURE=0.14527332485151376
